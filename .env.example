# ============================================================================
# Joinin environment configuration
# ============================================================================
# Copy to `.env` and fill in the values from your Supabase project settings
# (Project Settings -> API).
#
# The publishable key is designed to be public. It is safe in the browser ONLY because
# every table in this schema has Row Level Security enabled and every RPC
# re-checks permissions server-side (PRD 41). Never put the service_role key in
# a VITE_ variable -- anything prefixed VITE_ ships to the browser.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=