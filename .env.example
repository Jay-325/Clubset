# ============================================================================
# Clubset environment configuration
# ============================================================================
# Copy to `.env` and fill in the values from your Supabase project settings
# (Project Settings -> API).
#
# The publishable key is designed to be public. It is safe in the browser ONLY because
# every table in this schema has Row Level Security enabled and every RPC
# re-checks permissions server-side (PRD 41). Never put the service_role key in
# a VITE_ variable -- anything prefixed VITE_ ships to the browser.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Server / CLI only. NEVER prefix these with VITE_ and never commit .env.
#
# SUPABASE_ACCESS_TOKEN is a management-API token for the Supabase CLI. It can
# read and change the whole project, so it must live only in the local,
# git-ignored .env (or an OS keyring) -- never in the repository, a migration,
# a VITE_ variable, or an agent config file.
# ---------------------------------------------------------------------------
SUPABASE_ACCESS_TOKEN=
