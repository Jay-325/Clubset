{
  // Public runtime variables for the Cloudflare Worker.
  //
  // This is the source config Nitro reads during `vite build` and merges into
  // the generated `.output/server/wrangler.json` (via .wrangler/deploy/config.json).
  // Nitro keeps its generated name, main, assets, compatibility flags, and rules;
  // only `vars` is added here.
  //
  // These values are public (browser-safe anon key and Turnstile site key).
  // Never add TURNSTILE_SECRET_KEY, a Supabase service-role key, or database
  // passwords to this file.
  "vars": {
    // Public runtime variables for the Cloudflare Worker. The deployment
    // platform must supply real values for these; empty placeholders prevent
    // a live project key from being baked into the built artifact.
    "VITE_SUPABASE_ANON_KEY": "",
    "VITE_SUPABASE_URL": "",
    "VITE_TURNSTILE_SITE_KEY": ""
  }
}
