# Local agent tooling config. opencode.json points this workspace at a remote
# MCP endpoint for the linked Supabase project and is machine/agent-local; it
# must never travel with the repository (Lovable syncs the branch).
opencode.json
opencode.jsonc
opencode.local.json

# Agent skill data caches. The skill definitions themselves live in
# .agents/skills/ and ARE tracked; only the per-run data directories below
# are local state and must not travel with the repository.
.agents/answers/
.agents/summaries/
.agents/run-logs/
.agents/handoff/
.agents/test-logs/

